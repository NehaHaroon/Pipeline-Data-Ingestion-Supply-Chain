FROM python:3.11-slim

RUN useradd --create-home --shell /bin/bash app

WORKDIR /app
ENV PYTHONPATH=/app

RUN apt-get update && \
    apt-get install -y curl build-essential git && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir --upgrade pip setuptools wheel

# Same base stack as ingestion (requirements.txt unchanged), then Part 3 extras only
COPY requirements.txt requirements-part3-extras.txt constraints-part3.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-part3-extras.txt -c constraints-part3.txt

COPY . .

RUN mkdir -p storage/raw storage/ingested storage/quarantine storage/cdc_log \
    storage/checkpoints storage/semantic/parquet storage/analytics logs && \
    chown -R app:app /app

USER app

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

CMD ["uvicorn", "analytics_service:app", "--host", "0.0.0.0", "--port", "8002"]
